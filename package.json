{
  "name": "mymate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "test": "mocha",
    "prepare": "husky",
    "test:watch": "mocha --watch",
    "preview": "vite preview --port 3000 --open",
    "prestart": "npm install",
    "start": "vite build && vite preview --port 3000",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write src",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "check": "npm run type-check && npm run lint:check"
  },
  "lint-staged": {
    "*.ts": [
      "npm run test"
    ]
  },
  "directories": {
    "src": "./src",
    "test": "./test"
  },
  "devDependencies": {
    "@babel/cli": "^7.12.1",
    "@babel/core": "^7.12.3",
    "@babel/preset-env": "^7.12.1",
    "@babel/preset-typescript": "^7.12.1",
    "@babel/register": "^7.12.1",
    "@eslint/js": "^9.39.0",
    "@types/chai": "^5.2.3",
    "@types/handlebars": "^4.0.40",
    "@types/jsdom": "^28.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.1.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "autoprefixer": "^10.4.23",
    "chai": "^6.2.2",
    "cssnano": "^7.1.2",
    "eslint": "^9.39.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.3.3",
    "mocha": "^11.3.0",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "postcss-mixins": "^12.1.2",
    "postcss-nested": "^7.0.2",
    "postcss-preset-env": "^10.5.0",
    "stylelint": "^16.14.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-handlebars": "^1.5.0"
  },
  "dependencies": {
    "express": "^4.22.1",
    "handlebars": "^4.7.8",
    "lodash-es": "^4.17.22"
  }
}
