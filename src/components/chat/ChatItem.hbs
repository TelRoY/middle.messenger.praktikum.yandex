{{!--
  Компонент элемента списка чатов
  
  Параметры:
  - id: идентификатор чата
  - avatar: URL аватара
  - name: имя собеседника или название чата
  - lastMessage: последнее сообщение
  - time: время последнего сообщения
  - unread: количество непрочитанных сообщений
  - active: активен ли чат
--}}

<li class="chat-item {{#if active}}chat-item--active{{/if}}" data-chat-id="{{id}}">
  <div class="chat-item__avatar">
    <div class="chat-item__avatar-placeholder">
      {{#if name}}
        {{substring name 0 1}}
      {{else}}
        ?
      {{/if}}
    </div>
  </div>
  
  <div class="chat-item__content">
    <div class="chat-item__header">
      <h3 class="chat-item__name">{{name}}</h3>
      <span class="chat-item__time">{{time}}</span>
    </div>
    
    <div class="chat-item__footer">
      <p class="chat-item__last-message">{{lastMessage}}</p>
      {{#if unread}}
        <span class="chat-item__badge">{{unread}}</span>
      {{/if}}
    </div>
</li>
