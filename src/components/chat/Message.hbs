{{!--
  Компонент сообщения
  
  Параметры:
  - id: идентификатор сообщения
  - text: текст сообщения
  - time: время отправки
  - isMine: мое ли сообщение
  - isRead: прочитано ли сообщение
  - avatar: URL аватара отправителя
  - name: имя отправителя
--}}

<div class="message {{#if isMine}}message--mine{{else}}message--theirs{{/if}}" data-message-id="{{id}}">
  {{#unless isMine}}
    <div class="message__avatar">
      <div class="message__avatar-placeholder">
        {{#if name}}
          {{substring name 0 1}}
        {{else}}
          ?
        {{/if}}
      </div>
    </div>
  {{/unless}}
  
  <div class="message__content">
    {{#unless isMine}}
      <div class="message__sender">{{name}}</div>
    {{/unless}}
    
    <div class="message__bubble">
      <div class="message__text">{{text}}</div>
      <div class="message__meta">
        <span class="message__time">{{time}}</span>
        {{#if isMine}}
          <span class="message__status {{#if isRead}}message__status--read{{else}}message__status--sent{{/if}}">
            {{#if isRead}}
              ✓✓
            {{else}}
              ✓
            {{/if}}
          </span>
        {{/if}}
      </div>
    </div>
  </div>
</div>
