<div class="message-input-container">
  <div class="message-input">
    <form class="message-input__form" id="message-form">
      <div class="message-input__wrapper">
        <input
          type="text"
          class="message-input__field"
          id="message"
          name="message"
          placeholder="{{placeholder}}"
          autocomplete="off"
          value="{{value}}"
        />
        <button type="submit" class="message-input__button">
          <svg class="message-input__icon" width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M22 2L11 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M22 2L15 22L11 13L2 9L22 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </form>
  </div>
</div>
