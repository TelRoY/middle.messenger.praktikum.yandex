<form id="{{id}}" class="{{className}}">
  <div class="form-row">
    <div class="form-group">
      {{{firstNameInput}}}
    </div>
    <div class="form-group">
      {{{secondNameInput}}}
    </div>
  </div>
  
  <div class="form-group">
    {{{loginInput}}}
  </div>
  
  <div class="form-group">
    {{{emailInput}}}
  </div>
  
  <div class="form-group">
    {{{passwordInput}}}
  </div>
  
  <div class="form-group">
    {{{phoneInput}}}
  </div>
  
  <div class="form-buttons registration-buttons">
    {{{submitButton}}}
    {{{loginButton}}}
  </div>
</form>
